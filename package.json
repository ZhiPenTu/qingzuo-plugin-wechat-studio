{
  "name": "@qingzuo/plugin-wechat-studio",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhiPenTu/qingzuo-plugin-wechat-studio.git"
  },
  "commerce": {
    "manifestVersion": 1,
    "id": "official.wechat-studio",
    "title": "公众号 AI 工作台",
    "description": "从选题、写作、审稿、排版、配图到公众号草稿与发布的一体化工作台，支持业务素材库、预设包和贴图流程",
    "category": "内容创作",
    "api": "^1.9.0",
    "ui": "ui/index.html",
    "icon": "data:image/png;base64,",
    "releaseNotes": "配图页支持读取官方共享模型与兼容服务中的公开生图模型，并在创建生成批次时携带正确来源，修复图片模型下拉为空及代理模型无法生成的问题。",
    "permissions": {
      "files": true,
      "storage": true,
      "ai": [
        "text",
        "image-edit"
      ],
      "workspace": true,
      "mcp": [
        "read"
      ],
      "wechat": [
        "draft",
        "publish",
        "list"
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:host": "node tests/host.mjs",
    "sync:icon": "node scripts/sync-icon.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  },
  "license": "Apache-2.0"
}
