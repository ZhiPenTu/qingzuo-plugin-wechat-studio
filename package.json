{
  "name": "@qingzuo/plugin-wechat-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.wechat-studio",
    "title": "公众号 AI 工作台",
    "description": "从选题、写作、审稿、排版、配图到公众号草稿与发布的一体化工作台，支持业务素材库、预设包和贴图流程",
    "category": "内容创作",
    "api": "^1.9.0",
    "ui": "ui/index.html",
    "releaseNotes": "首个版本：五步配置台、完整创作流水线、文章改写与新写、业务素材库、贴图流程，以及工作区、远程 MCP 和公众号草稿/发布能力。",
    "permissions": {
      "files": true,
      "storage": true,
      "ai": [
        "text",
        "image-edit"
      ],
      "workspace": true,
      "mcp": [
        "read"
      ],
      "wechat": [
        "draft",
        "publish",
        "list"
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "pack": "node scripts/pack-plugin.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "license": "Apache-2.0"
}
